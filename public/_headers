# Cloudflare Pages (cùng cú pháp Netlify): model và ảnh không đổi nội dung theo URL → trình duyệt giữ lâu, F5 không tải lại
/models/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/presets/*
  Cache-Control: public, max-age=604800
/home/*
  Cache-Control: public, max-age=604800
/decals/*
  Cache-Control: public, max-age=604800
